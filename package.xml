<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_basic</name>
  <version>1.0.0</version>
  <description>Spot Basic library</description>
  <maintainer email="opensource@rai-inst.com">RAI Institute</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/rai-opensource/spot_basic</url>
  <url type="bugtracker">https://github.com/rai-opensource/spot_basic/issues</url>

  <depend>bosdyn_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>controller_manager_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>python3-scipy</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>spot_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>synchros2</depend>

  <exec_depend>spot_driver</exec_depend>
  <exec_depend>spot_ros2_control</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-prompt-toolkit</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-cov</test_depend>
  <test_depend>python3-pytest-timeout</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
